{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plakar ETCD Importer Connector Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location"
  ],
  "properties": {
    "location": {
      "type": "string",
      "minLength": 1,
      "description": "ETCD server url"
    },
    "username": {
      "type": "string",
      "minLength": 1,
      "description": "ETCD username"
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "description": "ETCD password"
    },
    "endpoints": {
      "type": "string",
      "description": "Comma-separated list of endpoints"
    },
    "plaintext": {
      "type": "boolean",
      "default": false,
      "description": "Connect over plain http for an etcd:// location (dangerous; credentials travel in cleartext)"
    },
    "tls_insecure_no_verify": {
      "type": "boolean",
      "default": false,
      "description": "Disable TLS certificate verification (dangerous; anyone could impersonate the server)"
    }
  }
}
