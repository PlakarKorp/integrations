{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plakar K8S Importer Connector Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location",
    "volume_snapshot_class"
  ],
  "properties": {
    "location": {
      "type": "string",
      "minLength": 1,
      "description": "optional endpoint with optional namespace"
    },
    "kubeconfig": {
      "type": "string",
      "description": "Kube config content to use"
    },
    "volume_snapshot_class": {
      "type": "string",
      "description": "Volume snapshot class"
    },
    "node_affinity": {
      "type": "string",
      "description": "Optional node affinity for the kubelet pod, as the YAML or JSON body of a pod's spec.affinity.nodeAffinity"
    },
    "kubelet_image": {
      "type": "string",
      "description": "Optional kubelet image to use"
    },
    "fs_access": {
      "type": "string",
      "enum": [
        "default",
        "read",
        "full"
      ],
      "default": "read",
      "description": "Optional file access capabilities granted to the pod: default to not gain extra capabilities, read to only gain read capabilities, or full to gain write capabilities as well."
    }
  }
}
