{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plakar K8S Importer Connector Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location"
  ],
  "properties": {
    "location": {
      "type": "string",
      "minLength": 1,
      "description": "Endpoint with optional namespace"
    },
    "kubeconfig": {
      "type": "string",
      "description": "Kube config content to use"
    },
    "kubelet_image": {
      "type": "string",
      "description": "Optional kubelet image to use"
    },
    "fs_access": {
      "type": "string",
      "enum": [
        "default",
        "read",
        "full"
      ],
      "default": "read",
      "description": "Optional file access capabilities granted to the pod: default to not gain extra capabilities, read to only gain read capabilities, or full to gain write capabilities as well."
    }
  }
}
