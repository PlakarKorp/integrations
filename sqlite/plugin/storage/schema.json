{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plakar SQLite Storage Connector Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location"
  ],
  "properties": {
    "location": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sqlite://.+",
      "description": "SQLite location URI: sqlite://<path to the database file>"
    }
  }
}
