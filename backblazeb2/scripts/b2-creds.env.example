# Copy this file to b2-creds.env (gitignored) and fill in real values.
#   cp scripts/b2-creds.env.example scripts/b2-creds.env
#
# Create an application key in the Backblaze B2 console (Account > App Keys).
# Scope it to a single bucket if possible.

# Name of an existing bucket the application key can read/write.
B2_BUCKET=

# "keyID" from the B2 App Keys page.
B2_ACCESS_KEY_ID=

# "applicationKey" from the B2 App Keys page (shown only once at creation time).
B2_APPLICATION_KEY=

# Optional: object key prefix to use inside the bucket for this test run.
# Leave empty to auto-generate a unique prefix (recommended, avoids clobbering
# anything else stored in the bucket).
B2_PREFIX=
